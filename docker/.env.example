# Copy to docker/.env only if it does not exist. This pulls the published image.
# For an opt-in local build, set PADDLEOCR_IMAGE=paddleocr-gb10:0.2.0.
PADDLEOCR_IMAGE=ghcr.io/n7tequila/paddleocr-gb10:0.2.0
PADDLEOCR_BIND=127.0.0.1
PADDLEOCR_PUBLIC_PORT=8080
# Bind-mounted persistent cache; relative paths resolve under docker/.
# Replace with your own absolute path if models are already cached elsewhere.
PADDLEX_CACHE=./model-cache
